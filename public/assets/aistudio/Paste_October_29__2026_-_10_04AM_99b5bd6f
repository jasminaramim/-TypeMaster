## ৪. প্রথম version-এর working code

এই version-এ থাকবে:

- English ও বাংলা typing test
- 15, 30, 60, 120 সেকেন্ডের timer
- Live typing, WPM, accuracy ও error count
- Test complete ও restart
- Learning lessons
- Typing challenge game
- Local test history
- Demo leaderboard

প্রথমে `app/page.js` ফাইলটি খোলো। ভেতরের পুরোনো code মুছে নিচের সম্পূর্ণ code বসাও।

```

"use client";

import { useEffect, useState } from "react";

const PASSAGES = {
  English:
    "Practice every day to improve your typing speed and accuracy. Keep your fingers on the home row, stay relaxed, and focus on typing correctly before trying to type faster. Small improvements every day lead to great results.",
  বাংলা:
    "নিয়মিত অনুশীলন করলে টাইপিং স্পিড এবং নির্ভুলতা বাড়ানো সম্ভব। প্রথমে সঠিকভাবে টাইপ করার চেষ্টা করো। ধীরে ধীরে হাতের আঙুলের ব্যবহার শিখো এবং প্রতিদিন কিছু সময় অনুশীলন করো।",
};

const LESSONS = [
  {
    title: "Lesson 01 — Home Row",
    subtitle: "Start with the home row keys.",
    keys: "A S D F   J K L ;",
  },
  {
    title: "Lesson 02 — Top Row",
    subtitle: "Practice the top row of your keyboard.",
    keys: "Q W E R T Y U I O P",
  },
  {
    title: "Lesson 03 — Bottom Row",
    subtitle: "Practice the bottom row.",
    keys: "Z X C V B N M",
  },
];

const DEMO_LEADERS = [
  { name: "SpeedMaster", wpm: 112 },
  { name: "FastFingers", wpm: 98 },
  { name: "TypingPro", wpm: 87 },
  { name: "KeyboardHero", wpm: 76 },
  { name: "NewLearner", wpm: 65 },
];

const initialHistory = [];

export default function Home() {
  const [tab, setTab] = useState("test");
  const [language, setLanguage] = useState("English");
  const [duration, setDuration] = useState(30);
  const [typed, setTyped] = useState("");
  const [remaining, setRemaining] = useState(30);
  const [isRunning, setIsRunning] = useState(false);
  const [finished, setFinished] = useState(false);
  const [history, setHistory] = useState(initialHistory);
  const [loaded, setLoaded] = useState(false);
  const [lessonIndex, setLessonIndex] = useState(0);
  const [lessonTyped, setLessonTyped] = useState("");

  const passage = PASSAGES[language];
  const targetChars = Array.from(passage);
  const typedChars = Array.from(typed);

  const correct = typedChars.filter(
    (char, index) => char === targetChars[index]
  ).length;

  const errors = typedChars.filter(
    (char, index) => char !== targetChars[index]
  ).length;

  const accuracy = typedChars.length
    ? Math.round((correct / typedChars.length) * 100)
    : 100;

  const elapsed = Math.max(1, duration - remaining);
  const wpm = Math.round(correct / 5 / (elapsed / 60));

  useEffect(() => {
    try {
      const saved = JSON.parse(
        localStorage.getItem("typemaster-history") || "[]"
      );
      if (Array.isArray(saved)) setHistory(saved);
    } catch {
      setHistory([]);
    }
    setLoaded(true);
  }, []);

  useEffect(() => {
    if (!isRunning) return;

    const timer = setInterval(() => {
      setRemaining((previous) => {
        if (previous <= 1) {
          clearInterval(timer);
          setIsRunning(false);
          setFinished(true);
          return 0;
        }
        return previous - 1;
      });
    }, 1000);

    return () => clearInterval(timer);
  }, [isRunning]);

  useEffect(() => {
    if (!finished || !loaded) return;

    const result = {
      id: Date.now(),
      language,
      wpm,
      accuracy,
      errors,
      duration,
      date: new Date().toLocaleString(),
    };

    setHistory((previous) => {
      const updated = [result, ...previous].slice(0, 50);
      try {
        localStorage.setItem(
          "typemaster-history",
          JSON.stringify(updated)
        );
      } catch {}
      return updated;
    });
    // Save once for each completed test.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [finished]);

  function resetTest(nextDuration = duration) {
    setTyped("");
    setRemaining(nextDuration);
    setDuration(nextDuration);
    setIsRunning(false);
    setFinished(false);
  }

  function handleTyping(event) {
    if (finished) return;

    const value = event.target.value;
    setTyped(value);

    if (value.length > 0 && !isRunning) {
      setIsRunning(true);
    }

    if (Array.from(value).length >= targetChars.length) {
      setIsRunning(false);
      setFinished(true);
    }
  }

  function changeLanguage(nextLanguage) {
    setLanguage(nextLanguage);
    resetTest();
  }

  const bestWpm = history.length
    ? Math.max(...history.map((item) => item.wpm))
    : 0;

  const averageWpm = history.length
    ? Math.round(
        history.reduce((sum, item) => sum + item.wpm, 0) /
          history.length
      )
    : 0;

  const navItems = [
    { id: "test", label: "Typing Test", icon: "⌨" },
    { id: "learn", label: "Learn", icon: "✳" },
    { id: "games", label: "Typing Games", icon: "♟" },
    { id: "history", label: "My History", icon: "◷" },
    { id: "leaderboard", label: "Leaderboard", icon: "♛" },
  ];

  return (
    <main className="min-h-screen bg-[#111310] text-[#eeeeea]">
      <header className="sticky top-0 z-10 border-b border-white/10 bg-[#111310]/95 backdrop-blur">
        <div className="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4">
          <button
            onClick={() => setTab("test")}
            className="flex items-center gap-3"
          >
            <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#d7ff64] text-xl font-black text-[#151710]">
              T
            </span>
            <span className="text-xl font-bold tracking-tight">
              Type<span className="text-[#d7ff64]">Master</span>
            </span>
          </button>

          <div className="hidden items-center gap-1 md:flex">
            {navItems.map((item) => (
              <button
                key={item.id}
                onClick={() => setTab(item.id)}
                className={`rounded-lg px-3 py-2 text-sm transition ${
                  tab === item.id
                    ? "bg-[#d7ff64]/10 text-[#d7ff64]"
                    : "text-[#a4a69d] hover:bg-white/5 hover:text-white"
                }`}
              >
                {item.label}
              </button>
            ))}
          </div>

          <span className="rounded-full border border-[#d7ff64]/30 px-3 py-1.5 text-xs text-[#d7ff64]">
            FREE PRACTICE
          </span>
        </div>

        <nav className="flex gap-2 overflow-x-auto px-5 pb-3 md:hidden">
          {navItems.map((item) => (
            <button
              key={item.id}
              onClick={() => setTab(item.id)}
              className={`shrink-0 rounded-lg px-3 py-2 text-xs ${
                tab === item.id
                  ? "bg-[#d7ff64] text-black"
                  : "bg-white/5 text-gray-300"
              }`}
            >
              {item.label}
            </button>
          ))}
        </nav>
      </header>

      <div className="mx-auto max-w-6xl px-5 py-10 md:py-14">
        {tab === "test" && (
          <>
            <section className="mb-10 text-center">
              <div className="mb-4 inline-flex rounded-full border border-[#d7ff64]/20 bg-[#d7ff64]/5 px-4 py-2 text-sm text-[#d7ff64]">
                ✦ Your daily typing workout
              </div>
              <h1 className="text-4xl font-black tracking-tight sm:text-6xl">
                Type faster.
                <br />
                <span className="text-[#d7ff64]">
                  Think smarter.
                </span>
              </h1>
              <p className="mx-auto mt-5 max-w-xl text-sm leading-7 text-[#a4a69d] sm:text-base">
                Practice Bangla and English typing, track your
                speed, and improve one keystroke at a time.
              </p>
            </section>

            <section className="rounded-2xl border border-white/10 bg-[#191b17] p-5 shadow-2xl sm:p-8">
              <div className="mb-8 flex flex-wrap items-center justify-between gap-4">
                <div className="flex gap-2">
                  {["English", "বাংলা"].map((item) => (
                    <button
                      key={item}
                      onClick={() => changeLanguage(item)}
                      className={`rounded-lg px-4 py-2.5 text-sm font-semibold ${
                        language === item
                          ? "bg-[#d7ff64] text-[#151710]"
                          : "bg-white/5 text-gray-300 hover:bg-white/10"
                      }`}
                    >
                      {item}
                    </button>
                  ))}
                </div>

                <div className="flex flex-wrap gap-2">
                  {[15, 30, 60, 120].map((seconds) => (
                    <button
                      key={seconds}
                      onClick={() => resetTest(seconds)}
                      className={`rounded-lg border px-3 py-2 text-sm ${
                        duration === seconds
                          ? "border-[#d7ff64]/50 bg-[#d7ff64]/10 text-[#d7ff64]"
                          : "border-white/10 text-gray-400 hover:border-white/30"
                      }`}
                    >
                      {seconds}s
                    </button>
                  ))}
                </div>
              </div>

              <div className="mb-8 grid grid-cols-3 gap-3">
                {[
                  {
                    label: "TIME LEFT",
                    value: `${remaining}s`,
                  },
                  { label: "LIVE WPM", value: wpm },
                  { label: "ACCURACY", value: `${accuracy}%` },
                ].map((stat) => (
                  <div
                    key={stat.label}
                    className="rounded-xl border border-white/5 bg-[#111310] p-4 text-center"
                  >
                    <p className="text-[10px] font-bold tracking-[0.15em] text-gray-500 sm:text-xs">
                      {stat.label}
                    </p>
                    <p className="mt-2 text-2xl font-bold text-[#d7ff64] sm:text-3xl">
                      {stat.value}
                    </p>
                  </div>
                ))}
              </div>

              <div className="mb-5 rounded-xl border border-white/5 bg-[#111310] p-5 sm:p-7">
                <p className="mb-4 text-xs font-semibold uppercase tracking-widest text-gray-500">
                  Type the text below
                </p>
                <div className="min-h-32 font-mono text-lg leading-9 tracking-wide sm:text-xl">
                  {targetChars.map((char, index) => {
                    let color = "text-[#6d7165]";

                    if (index < typedChars.length) {
                      color =
                        char === typedChars[index]
                          ? "text-[#d7ff64]"
                          : "rounded-sm bg-red-500/20 text-red-400";
                    }

                    if (index === typedChars.length && !finished) {
                      return (
                        <span
                          key={index}
                          className={`${color} border-l-2 border-[#d7ff64]`}
                        >
                          {char}
                        </span>
                      );
                    }

                    return (
                      <span key={index} className={color}>
                        {char}
                      </span>
                    );
                  })}
                </div>
              </div>

              <label
                htmlFor="typing-input"
                className="mb-2 block text-sm text-gray-400"
              >
                Your typing area
              </label>
              <textarea
                id="typing-input"
                value={typed}
                onChange={handleTyping}
                disabled={finished || remaining === 0}
                placeholder={
                  finished
                    ? "Test complete! Press Try Again."
                    : "Start typing here..."
                }
                className="min-h-32 w-full resize-y rounded-xl border border-white/10 bg-[#111310] p-4 font-mono text-base leading-7 text-white outline-none transition placeholder:text-gray-600 focus:border-[#d7ff64]/60 disabled:opacity-60"
                spellCheck={false}
                autoCapitalize="off"
                autoCorrect="off"
              />

              <div className="mt-5 flex flex-wrap items-center justify-between gap-4">
                <p className="text-sm text-gray-500">
                  Errors:{" "}
                  <span className="font-bold text-red-400">
                    {errors}
                  </span>{" "}
                  · Characters: {typedChars.length}
                </p>
                <button
                  onClick={() => resetTest()}
                  className="rounded-xl bg-[#d7ff64] px-6 py-3 font-bold text-[#151710] transition hover:bg-[#e5ff9b]"
                >
                  ↻ Try Again
                </button>
              </div>

              {finished && (
                <div className="mt-6 rounded-xl border border-[#d7ff64]/20 bg-[#d7ff64]/5 p-5">
                  <h2 className="text-xl font-bold text-[#d7ff64]">
                    Test completed!
                  </h2>
                  <p className="mt-2 text-sm text-gray-300">
                    Your result: {wpm} WPM, {accuracy}% accuracy
                    and {errors} errors.
                  </p>
                </div>
              )}
            </section>

            <section className="mt-6 grid gap-4 sm:grid-cols-3">
              {[
                {
                  label: "PERSONAL BEST",
                  value: `${bestWpm} WPM`,
                },
                {
                  label: "AVERAGE SPEED",
                  value: `${averageWpm} WPM`,
                },
                {
                  label: "TESTS COMPLETED",
                  value: history.length,
                },
              ].map((stat) => (
                <div
                  key={stat.label}
                  className="rounded-xl border border-white/10 bg-[#191b17] p-5"
                >
                  <p className="text-xs tracking-widest text-gray-500">
                    {stat.label}
                  </p>
                  <p className="mt-3 text-2xl font-bold">
                    {stat.value}
                  </p>
                </div>
              ))}
            </section>
          </>
        )}

        {tab === "learn" && (
          <section>
            <p className="mb-3 text-sm font-semibold text-[#d7ff64]">
              LEARNING CENTER
            </p>
            <h1 className="text-4xl font-black">
              Build your typing skills.
            </h1>
            <p className="mt-3 text-gray-400">
              Learn keyboard positions one lesson at a time.
            </p>

            <div className="mt-8 grid gap-4 md:grid-cols-3">
              {LESSONS.map((lesson, index) => (
                <button
