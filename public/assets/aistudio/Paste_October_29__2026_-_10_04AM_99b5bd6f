                    <th className="p-4">Errors</th>
                  </tr>
                </thead>
                <tbody>
                  {history.map((item) => (
                    <tr
                      key={item.id}
                      className="border-b border-white/5"
                    >
                      <td className="p-4 text-gray-400">
