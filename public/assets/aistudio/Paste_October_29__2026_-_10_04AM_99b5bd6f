                      {player.name}
                    </span>
                  </div>
                  <span className="font-bold text-[#d7ff64]">
                    {player.wpm} WPM
                  </span>
                </div>
              ))}
            </div>
            <p className="mt-4 text-sm text-gray-500">
              These are sample values, not real user rankings.
              A server and database are required for a global
              leaderboard.
            </p>
          </section>
        )}

        <footer className="mt-16 border-t border-white/10 pt-7 text-center text-sm text-gray-500">
          <p>
            <span className="font-bold text-[#d7ff64]">
              TypeMaster
            </span>{" "}
            — Practice daily. Improve endlessly.
          </p>
          <p className="mt-2">
            Bangla & English Typing Practice
          </p>
        </footer>
      </div>
    </main>
  );
