                        No results yet. Complete your first
                        typing test to see your history here.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {tab === "leaderboard" && (
          <section>
            <p className="mb-3 text-sm font-semibold text-[#d7ff64]">
              COMMUNITY
            </p>
            <h1 className="text-4xl font-black">
              Leaderboard
            </h1>
